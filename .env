# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_RETRY_MAX_ATTEMPTS=3

# Queues
RABBITMQ_QUEUE_MESSAGE=queue-message-chat-sauvegarde
RABBITMQ_QUEUE_MESSAGE_DLQ=queue-message-chat-sauvegarde.dlq

# Exchanges
RABBITMQ_EXCHANGE_MESSAGE=exchange-message
RABBITMQ_EXCHANGE_DLQ=exchange-message.dlq

# Routing keys
RABBITMQ_ROUTING_MESSAGE=routing-message-chat-sauvegarde
RABBITMQ_ROUTING_DLQ=routing-message-chat-sauvegarde.dlq

# MongoDB
MONGODB_URI=mongodb://mongo:27017/togezzer

# Server
SERVER_PORT=8081